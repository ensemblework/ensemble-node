# Ensemble Node website. Copy to apps/node-web/.env.local for local overrides.
# Both are public (baked into the browser bundle at build time). Use localhost, not 127.0.0.1,
# so the browser shares Ensemble's session cookie with this site.

# Ensemble's API. Production: https://api.ensemblework.com
NEXT_PUBLIC_ENSEMBLE_API=http://localhost:4000
# The Ensemble app, for links to tasks, Needs me and settings. Production: https://app.ensemblework.com
NEXT_PUBLIC_ENSEMBLE_APP=http://localhost:3000
