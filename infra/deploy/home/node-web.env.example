# The Ensemble Node website on the home server (infra/deploy/home). Copy to
# ~/ensemble-node-host/node-web.env, mode 0600. Nothing here is a secret today: the tunnel's
# credentials are their own file in ~/ensemble-node-host/cloudflared/.

# The website's public address. Its host is the tunnel's ingress rule and what watchdog.sh checks.
NODE_WEB_PUBLIC_URL=https://node.ensemblework.com
# Loopback port for `next start`. Ensemble's home install uses 14000, 15055, 15432 and 16379;
# development uses 3300.
NODE_WEB_PORT=13300

# Baked into the browser bundle when a release is built (apps/node-web/lib/config.ts). After
# changing them, run `bash ~/ensemble-node-host/bin/update.sh` to build and serve a new release.
NEXT_PUBLIC_ENSEMBLE_API=https://api.ensemblework.com
NEXT_PUBLIC_ENSEMBLE_APP=https://app.ensemblework.com

# From `cloudflared tunnel create ensemble-node`. Its <id>.json goes in ~/ensemble-node-host/cloudflared/.
ENSEMBLE_NODE_TUNNEL_ID=

# deploy.yml fast-forwards this branch after CI passes on main.
ENSEMBLE_NODE_DEPLOY_BRANCH=production
# on: the timer deploys each new commit of the branch within a minute or two.
# off: nothing deploys until `bash ~/ensemble-node-host/bin/update.sh`.
ENSEMBLE_NODE_AUTODEPLOY=on
