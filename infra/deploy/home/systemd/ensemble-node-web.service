[Unit]
Description=Ensemble Node website (home server, user unit)
# Serves the release ~/ensemble-node-host/current points at; update.sh switches it and restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/ensemble-node-host/current/apps/node-web
EnvironmentFile=%h/ensemble-node-host/node-web.env
# ENSEMBLE_NODE_COMMIT, written into each release by update.sh. /health reports it and
# deploy.yml waits for it.
EnvironmentFile=-%h/ensemble-node-host/current/.release-env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=%h/ensemble-node-host/node/bin:/usr/local/bin:/usr/bin:/bin
# Loopback only: the tunnel is the way in.
ExecStart=%h/ensemble-node-host/node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${NODE_WEB_PORT}
Restart=always
RestartSec=5
TimeoutStopSec=20
# Ensemble's API shares this machine; the website must never starve it.
MemoryHigh=768M
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=default.target
